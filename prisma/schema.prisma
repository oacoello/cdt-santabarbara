// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  email         String
  rank          String?   @default("Operador")
  role          Role      @default(USER)
  canUseSim     Boolean   @default(true)
  canUseCalc    Boolean   @default(false)
  canUseArchive Boolean   @default(false)
  canUseFT      Boolean   @default(false)
  reports       Report[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  title       String
  data        Json     
  timestamp   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}
