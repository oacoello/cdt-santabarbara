{
  "name": "santa-barbara-fdc",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "dev:server": "node scripts/dev-hp71-server.js",
    "dev:all": "npm run dev:server && npm run dev",
    "electron": "electron .",
    "dev:electron": "npm run dev",
    "dev:flex": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run dist:current",
    "postinstall": "prisma generate",
    "build:hp71:linux": "cmake -S HP71 -B HP71/build -DCMAKE_BUILD_TYPE=Release && cmake --build HP71/build --target hp71_emulator --config Release && node scripts/prepare-hp71-binary.js linux",
    "build:web": "prisma generate && next build && node scripts/prepare-electron-assets.js",
    "dist:win": "npm run build:web && node scripts/check-electron-package-assets.js win && electron-builder --win",
    "dist:linux": "npm run build:web && node scripts/check-electron-package-assets.js linux && electron-builder --linux",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "dist:current": "npm run build:web && node scripts/check-electron-package-assets.js current && electron-builder",
    "build:hp71:win": "cmake -S HP71 -B HP71/build -DCMAKE_BUILD_TYPE=Release && cmake --build HP71/build --target hp71_emulator --config Release && node scripts/prepare-hp71-binary.js win"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.9",
    "next-auth": "^5.0.0-beta.31",
    "patch-package": "^8.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "description": "Centro de tiro de cálculo automático para artillería.",
  "author": "Universidad de Defensa de Honduras UDH",
  "build": {
    "appId": "udh.santabarbara.cdt",
    "productName": "CDT Santa Barbara",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "!node_modules/**",
      "!.next/**",
      "!src/**",
      "!HP71/build/**",
      "!release/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next/standalone"
      },
      {
        "from": "HP71/dist",
        "to": "hp71",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "icon": "assets/icons/icon.ico",
      "publisherName": "Universidad de Defensa de Honduras UDH"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "icon": "assets/icons/icon.png",
      "maintainer": "Universidad de Defensa de Honduras UDH"
    },
    "npmRebuild": false,
    "compression": "normal",
    "extraMetadata": {
      "main": "main.js",
      "dependencies": {},
      "name": "santa-barbara-fdc",
      "version": "0.2.0",
      "description": "Centro de tiro de cálculo automático para artillería.",
      "author": "Universidad de Defensa de Honduras UDH"
    },
    "copyright": "Copyright © 2026 - Universidad de Defensa de Honduras UDH"
  }
}
